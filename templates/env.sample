# Flowie environment for the Codex port. Copy to .env at the target repo root
# only if you need overrides; normal Codex auth/config is read by `codex exec`.

# Optional overrides
# CODEX_PATH=codex                 # Codex binary if not on PATH
# PI_PATH=pi                       # legacy upstream Pi runtime
# PI_MODELS_PATH=~/.pi/agent/models.json
# ENGINEER_NAME=                   # engineer lane label, defaults to git user.name
